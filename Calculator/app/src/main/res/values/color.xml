<resources>

    <!-- ===== Palette: royal purple + deep gold + vivid orange on a soft lavender canvas ===== -->
    <color name="purple_ink">#F6EFFF</color>
    <color name="purple_vivid">#7B2CBF</color>
    <color name="purple_vivid_dark">#5E1A9E</color>
    <color name="purple_vivid_light">#9A4DE0</color>
    <color name="purple_soft">#E6D8FB</color>
    <color name="lavender_canvas">#000000</color>
    <color name="lavender_line">#2A2A2A</color>
    <color name="orange_vivid">#FF6A00</color>
    <color name="orange_text">#FF8A1F</color>
    <color name="gold_deep">#D9A000</color>
    <color name="gold_dark">#B07A00</color>
    <color name="gold_soft">#FFE7A8</color>
    <color name="gold_drawer">#FFF4D9</color>
    <color name="icon_tint">#CDB4F5</color>

    <!-- Default accent color (history dates, text handles). -->
    <color name="calculator_accent_color">#FFC53D</color>

    <!-- Primary color (history toolbar, "clear" reveal flash). -->
    <color name="calculator_primary_color">#7B2CBF</color>

    <!-- Colour behind the system bars: same as the canvas so it looks seamless. -->
    <color name="calculator_statusbar_color">#000000</color>

    <!-- Color to indicate an error has occured. -->
    <color name="calculator_error_color">#FF4D8D</color>

    <!-- Background color of the calculator display. -->
    <color name="display_background_color">#000000</color>

    <!-- Text color for the formula in the calculator display. -->
    <color name="display_formula_text_color">#F6EFFF</color>

    <!-- Colour of + - x / inside the formula. -->
    <color name="display_operator_text_color">#FF8A1F</color>

    <!-- Text color for the result in the calculator display. -->
    <color name="display_result_text_color">#B79BE0</color>

    <!-- Lighter color for exponent while scrolling. -->
    <color name="display_result_exponent_text_color">#7F62B0</color>

    <!-- Pads are transparent now: the keys carry the colour, not the pad. -->
    <color name="pad_numeric_background_color">#00000000</color>
    <color name="pad_operator_background_color">#00000000</color>

    <!-- The scientific page slides over the main pad like a drawer. -->
    <color name="pad_advanced_background_color">#000000</color>

    <!-- Text colours. -->
    <color name="pad_button_text_color">#F6EFFF</color>
    <color name="pad_button_function_text_color">#E2C9FF</color>
    <color name="pad_button_operator_text_color">#FFFFFF</color>
    <color name="pad_button_advanced_text_color">#FFD66B</color>

    <!-- Ripples. -->
    <color name="pad_button_ripple_color">#55FFFFFF</color>
    <color name="pad_button_light_ripple_color">#55FFFFFF</color>
    <color name="pad_button_advanced_ripple_color">#55FFC53D</color>

    <!-- Key fills. -->
    <color name="key_number_fill">#3B1C73</color>
    <color name="key_number_stroke">#4E2A92</color>
    <color name="key_function_fill">#5B2D99</color>
    <color name="key_advanced_fill">#5A3F00</color>
    <color name="key_advanced_selected_fill">#8A5F00</color>

    <!-- Background color for empty history view. -->
    <color name="empty_history_color">#121212</color>

</resources>
